# Dominio canónico del sitio (SEO: sitemap, canonical, Open Graph).
SITE_URL=https://www.uniremington.edu.co

# --- Panel de administración (/admin) ---
# Clave usada para cifrar en reposo los secretos TOTP (2FA) guardados en la base de
# datos. Genera una propia con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se pierde o cambia, los usuarios existentes deben re-enrolar su 2FA.
CMS_SECRET_KEY=

# --- Integraciones opcionales (ya existentes) ---
CLIENTIFY_API_TOKEN=

# --- Chat de orientación (Remi) ---
# Clave de la API de Anthropic (Claude). Consíguela en https://console.anthropic.com/
ANTHROPIC_API_KEY=
