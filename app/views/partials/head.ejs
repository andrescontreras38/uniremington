<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %></title>
<meta name="description" content="<%= typeof desc !== 'undefined' ? desc : 'Corporación Universitaria Remington' %>">
<% if (typeof noindex !== 'undefined' && noindex){ %><meta name="robots" content="noindex,follow"><% } %>
<% if (typeof canonical !== 'undefined' && canonical){ %><link rel="canonical" href="<%= canonical %>"><% } %>
<meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>">
<meta property="og:site_name" content="Corporación Universitaria Remington">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= typeof desc !== 'undefined' ? desc : 'Corporación Universitaria Remington' %>">
<% if (typeof canonical !== 'undefined' && canonical){ %><meta property="og:url" content="<%= canonical %>"><% } %>
<% if (typeof ogImage !== 'undefined' && ogImage){ %><meta property="og:image" content="<%= ogImage %>"><meta name="twitter:card" content="summary_large_image"><% } else { %><meta name="twitter:card" content="summary"><% } %>
<% if (typeof jsonld !== 'undefined' && jsonld){ %><script type="application/ld+json"><%- JSON.stringify(jsonld) %></script><% } %>
<link rel="preconnect" href="https://www.uniremington.edu.co">
<link rel="icon" href="https://www.uniremington.edu.co/wp-content/uploads/2018/10/favicon-uniremington-32x32.png" sizes="32x32">
<link rel="icon" href="https://www.uniremington.edu.co/wp-content/uploads/2018/10/favicon-uniremington.png" sizes="192x192">
<link rel="apple-touch-icon" href="https://www.uniremington.edu.co/wp-content/uploads/2018/10/favicon-uniremington.png">
<!-- Sin preload a propósito: la fuente de íconos (220KB) competía por ancho de banda
     con el LCP en móvil bajo conexiones lentas (medido con PageSpeed Insights real).
     El navegador la descubre igual en cuanto el CSS pide @font-face — solo entra un
     instante después en vez de con máxima prioridad desde el primer byte. -->
<link rel="stylesheet" href="/css/fonts.css">
<link rel="stylesheet" href="/css/menu.css">
<link rel="stylesheet" href="/css/site.css">
<%- include('analytics') %>
</head>
<body>
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<%- include('navbar') %>
<span id="contenido" tabindex="-1"></span>
