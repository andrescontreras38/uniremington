      <img src="https://www.uniremington.edu.co/wp-content/uploads/2025/05/logo-uniremington.svg" alt="Uniremington" width="148" height="40">
    </a>

    <div class="navbar-links">
      <%
        // Menú principal (barra horizontal): públicos objetivo "SOY".
        // Las secciones grandes (INSTITUCIONAL, SEDES, etc.) viven ahora solo en la hamburguesa.
        var soyMenu = menuItems.find(function(x){ return (x.label || '').trim().toUpperCase() === 'SOY'; });
        var soyLinks = (soyMenu && soyMenu.children && soyMenu.children.length) ? soyMenu.children : [];
      %>
      <% soyLinks.forEach(function(c){ %>
        <a href="<%= c.href %>" class="nav-link"<%- attrs(c) %>><%= c.label %></a>
      <% }) %>
    </div>

    <div class="navbar-actions">
      <a href="<%= inscripcionUrl %>" target="_blank" rel="noopener" class="navbar-cta">Inscríbete Ahora</a>
    </div>
  </div>
</nav>

<!-- Drawer móvil -->
<div class="drawer" id="drawer" aria-hidden="true" inert>
  <div class="drawer-main-menu">
    <% menuItems.forEach(function(item){ %>
      <% if ((item.label || '').trim().toUpperCase() === 'SOY') return; /* SOY va en la sección siempre visible de abajo */ %>
      <% if (item.children && item.children.length){ %>
      <div class="m-section">
        <button class="m-acc" data-acc><%= item.label %><%- chevron %></button>
        <div class="m-acc-panel">
          <% item.children.forEach(function(c){ %>
            <% if (c.children && c.children.length){ %>
              <span class="m-subhead"><%= c.label %></span>
              <% c.children.forEach(function(g){ %><a href="<%= g.href %>"<%- attrs(g) %>><%= g.label %></a><% }) %>
            <% } else { %>
              <a href="<%= c.href %>"<%- attrs(c) %>><%= c.label %></a>
            <% } %>
          <% }) %>
        </div>
      </div>
      <% } else { %>
      <a class="m-link" href="<%= item.href %>"<%- attrs(item) %>><%= item.label %></a>
      <% } %>
    <% }) %>
  </div>

  <!-- SOY / públicos objetivo: en MÓVIL se muestran aquí (la barra horizontal está oculta);
       en ESCRITORIO se ocultan porque ya están en la barra horizontal (.drawer-soy en el CSS). -->
  <% var soy = menuItems.find(function(x){ return (x.label || '').trim().toUpperCase() === 'SOY'; }); %>
  <% if (soy && soy.children && soy.children.length){ %>
  <div class="drawer-soy">
    <span class="mega-eyebrow"><%= soy.label %></span>
    <div class="m-soy-list">
      <% soy.children.forEach(function(c){ %>
      <a class="m-soy" href="<%= c.href %>"<%- attrs(c) %>>
        <span class="m-soy-ic"><%- iconSvg(navIcon(c.label, soy.label)) %></span>
        <span class="m-soy-tx"><%= c.label %></span>
        <%- iconSvg('arrow_forward', 'm-soy-go') %>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Accesibilidad: abre el mismo panel del botón flotante (reutiliza toda su lógica). -->
  <button type="button" class="m-a11y" id="drawerA11y" aria-haspopup="dialog">
    <span class="m-a11y-ic">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="12" cy="12" r="10.6" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <circle cx="12" cy="7.4" r="1.7"/>
        <path d="M12 9.6c-2.7 0-5.2.7-5.2 1.8 0 .68.87 1.27 2.18 1.58l.5 2.02-1.66 4.28a1 1 0 0 0 1.86.73l1.55-4h1.58l1.55 4a1 1 0 0 0 1.86.73L14.54 15l.5-2.02c1.31-.31 2.18-.9 2.18-1.58 0-1.1-2.5-1.8-5.22-1.8Z"/>
      </svg>
    </span>
    <span class="m-a11y-tx">Accesibilidad</span>
    <%- iconSvg('arrow_forward', 'm-a11y-go') %>
  </button>

  <a class="m-cta" href="/programas">Explorar Programas &rarr;</a>
  <a class="m-cta m-cta--secondary" href="<%= inscripcionUrl %>" target="_blank" rel="noopener">Inscríbete Ahora</a>
</div>
