<style>
.chat-widget{position:fixed;right:20px;bottom:20px;z-index:90;font-family:inherit}
.chat-toggle{position:relative;width:58px;height:58px;border-radius:50%;border:0;cursor:pointer;
  background:#00457c;color:#fff;display:grid;place-items:center;box-shadow:0 6px 20px rgba(0,40,80,.4);
  transition:transform .15s,box-shadow .15s}
.chat-toggle:hover{transform:scale(1.06);box-shadow:0 10px 26px rgba(0,40,80,.5)}
.chat-toggle .msi{font-size:26px;position:absolute;transition:opacity .15s,transform .15s}
.chat-toggle .chat-ic-close{opacity:0;transform:scale(.6)}
.chat-widget.open .chat-toggle .chat-ic-open{opacity:0;transform:scale(.6)}
.chat-widget.open .chat-toggle .chat-ic-close{opacity:1;transform:scale(1)}
.chat-badge{position:absolute;top:-2px;right:-2px;width:14px;height:14px;border-radius:50%;
  background:#e30613;border:2px solid #fff}
.chat-widget.open .chat-badge{display:none}

.chat-panel{position:absolute;right:0;bottom:74px;width:min(360px,calc(100vw - 32px));
  height:min(520px,70vh);background:#fff;border-radius:18px;box-shadow:0 24px 60px rgba(0,40,80,.28);
  display:flex;flex-direction:column;overflow:hidden;
  opacity:0;visibility:hidden;transform:translateY(12px) scale(.98);transform-origin:bottom right;
  transition:opacity .18s ease,transform .18s ease,visibility 0s linear .18s}
.chat-widget.open .chat-panel{opacity:1;visibility:visible;transform:none;transition:opacity .18s ease,transform .18s ease}

.chat-head{display:flex;align-items:center;gap:10px;padding:14px 14px;background:#00457c;color:#fff;flex:none}
.chat-head-ic{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.16);display:grid;place-items:center;flex:none;overflow:hidden}
.chat-head-ic img{width:100%;height:100%;object-fit:cover;object-position:center 32%}
.chat-head-tx{display:flex;flex-direction:column;line-height:1.25;flex:1;min-width:0}
.chat-head-tx strong{font-size:.94rem}
.chat-head-tx span{font-size:.76rem;color:#bcd4ea}
.chat-close{background:none;border:0;color:#fff;cursor:pointer;width:30px;height:30px;border-radius:50%;
  display:grid;place-items:center;flex:none}
.chat-close:hover{background:rgba(255,255,255,.15)}

.chat-body{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;background:#f4f8fb}
.chat-msg{max-width:82%;padding:9px 13px;border-radius:14px;font-size:.88rem;line-height:1.45;white-space:pre-wrap;word-break:break-word}
.chat-msg-model{align-self:flex-start;background:#fff;color:#1c2b38;border-bottom-left-radius:4px;box-shadow:0 1px 3px rgba(0,40,80,.1)}
.chat-msg-model a{color:#00457c;font-weight:600;text-decoration:underline;word-break:break-all}
.chat-msg-model a:hover{color:#e30613}
.chat-msg-user a{color:#fff;text-decoration:underline;word-break:break-all}
.chat-msg-user{align-self:flex-end;background:#00457c;color:#fff;border-bottom-right-radius:4px}
.chat-typing{display:flex;gap:4px;align-items:center;padding:11px 14px}
.chat-typing span{width:6px;height:6px;border-radius:50%;background:#9fb3c4;animation:chat-bounce 1.1s infinite ease-in-out}
.chat-typing span:nth-child(2){animation-delay:.15s}
.chat-typing span:nth-child(3){animation-delay:.3s}
@keyframes chat-bounce{0%,60%,100%{transform:translateY(0);opacity:.5}30%{transform:translateY(-4px);opacity:1}}

.chat-form{display:flex;gap:8px;padding:10px;border-top:1px solid #e6ecf1;background:#fff;flex:none}
.chat-form textarea{flex:1;resize:none;border:1px solid #d8e1e9;border-radius:12px;padding:9px 12px;
  font:inherit;font-size:.88rem;max-height:120px;line-height:1.35}
.chat-form textarea:focus{outline:2px solid #00457c;outline-offset:1px}
.chat-send{flex:none;width:38px;height:38px;border-radius:50%;border:0;background:#e30613;color:#fff;
  cursor:pointer;display:grid;place-items:center;transition:background .2s}
.chat-send:hover{background:#b0050f}
.chat-send:disabled{background:#c9d3db;cursor:default}

@media (max-width:480px){
  .chat-widget{right:14px;bottom:14px}
  .chat-panel{width:calc(100vw - 24px);height:min(72vh,560px);bottom:70px}
}
@media (prefers-reduced-motion:reduce){
  .chat-panel,.chat-toggle .msi{transition:none}
  .chat-typing span{animation:none}
}
</style>

<div class="chat-widget" id="chatWidget">
  <button type="button" class="chat-toggle" id="chatToggle" aria-haspopup="dialog" aria-expanded="false"
          aria-controls="chatPanel" aria-label="Abrir a Remi, el asistente virtual de Uniremington">
    <span class="msi chat-ic-open" aria-hidden="true">support_agent</span>
    <span class="msi chat-ic-close" aria-hidden="true">close</span>
    <span class="chat-badge" aria-hidden="true"></span>
  </button>

  <div class="chat-panel" id="chatPanel" role="dialog" aria-label="Remi, asistente virtual de Uniremington" inert>
    <header class="chat-head">
      <span class="chat-head-ic"><img src="/img/remi-logo.webp" alt="" aria-hidden="true"></span>
      <div class="chat-head-tx">
        <strong>Remi</strong>
        <span>Asistente virtual · Uniremington</span>
      </div>
      <button type="button" class="chat-close" id="chatClose" aria-label="Cerrar chat"><span class="msi" aria-hidden="true">close</span></button>
    </header>
    <div class="chat-body" id="chatBody" aria-live="polite">
      <div class="chat-msg chat-msg-model">Hola, soy Remi, el asistente virtual de Uniremington. Puedo ayudarte con admisiones, programas académicos, sedes, modalidades y trámites institucionales. ¿En qué te puedo ayudar?</div>
    </div>
    <form class="chat-form" id="chatForm">
      <textarea id="chatInput" placeholder="Escribe tu pregunta…" rows="1" maxlength="600" aria-label="Escribe tu mensaje"></textarea>
      <button type="submit" class="chat-send" id="chatSend" aria-label="Enviar mensaje"><span class="msi" aria-hidden="true">send</span></button>
    </form>
  </div>
</div>

<script>
(function(){
  const widget = document.getElementById('chatWidget');
  if (!widget) return;
  const toggle = document.getElementById('chatToggle');
  const panel = document.getElementById('chatPanel');
  const closeBtn = document.getElementById('chatClose');
  const body = document.getElementById('chatBody');
  const form = document.getElementById('chatForm');
  const input = document.getElementById('chatInput');
  const sendBtn = document.getElementById('chatSend');

  let history = [];
  let chatLog = [];
  let sending = false;
  let opened = false;

  // Persiste la conversación en sessionStorage: sobrevive a que el usuario navegue a
  // otra página del sitio (o recargue) sin perder el historial, pero se limpia solo al
  // cerrar la pestaña/navegador — igual que "durante la sesión" se especificó siempre.
  const STORAGE_KEY = 'uniremington_chat_v1';
  function persist(){
    try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ log: chatLog, history })); }
    catch (e) { /* almacenamiento no disponible (privado, cuota, etc.): el chat sigue funcionando en memoria */ }
  }
  function loadPersisted(){
    try { return JSON.parse(sessionStorage.getItem(STORAGE_KEY) || 'null'); }
    catch (e) { return null; }
  }

  // Red de seguridad: el prompt le pide texto plano a Gemini, pero si igual se
  // le escapa algo de markdown, se limpia antes de mostrarlo (todo vía textContent,
  // nunca innerHTML, así que esto es solo estética, no una medida de seguridad).
  function stripMarkdown(text){
    return text
      .replace(/\*\*(.+?)\*\*/g, '$1')
      .replace(/\*(.+?)\*/g, '$1')
      .replace(/^#{1,6}\s+/gm, '')
      .replace(/^\s*[-*]\s+/gm, '- ');
  }

  // Convierte URLs en enlaces reales sin usar innerHTML con texto del modelo: se
  // reconocen con una expresión regular y cada <a> se construye a mano (href/target/
  // rel fijos por nosotros), así que no hay forma de inyectar HTML arbitrario.
  const URL_RE = /(https?:\/\/[^\s<>"')]+)/g;
  function renderMessageContent(row, text){
    text.split(URL_RE).forEach((part, i) => {
      if (i % 2 === 0) {
        if (part) row.appendChild(document.createTextNode(part));
        return;
      }
      let url = part;
      const trailMatch = url.match(/[.,;:!?)]+$/);
      const trail = trailMatch ? trailMatch[0] : '';
      if (trail) url = url.slice(0, -trail.length);
      const a = document.createElement('a');
      a.href = url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = url;
      row.appendChild(a);
      if (trail) row.appendChild(document.createTextNode(trail));
    });
  }

  function renderOne(role, text){
    const row = document.createElement('div');
    row.className = 'chat-msg chat-msg-' + role;
    renderMessageContent(row, role === 'model' ? stripMarkdown(text) : text);
    body.appendChild(row);
  }

  function addMessage(role, text){
    chatLog.push({ role, text });
    renderOne(role, text);
    body.scrollTop = body.scrollHeight;
    persist();
  }

  // Al cargar la página: si hay una conversación guardada de esta misma sesión del
  // navegador, se restaura tal cual (mensajes + historial que se envía a la API);
  // si no, se registra el saludo inicial (ya presente en el HTML) para que si el
  // usuario sí escribe algo, quede guardado desde el primer mensaje.
  (function restoreOrInit(){
    const saved = loadPersisted();
    if (saved && Array.isArray(saved.log) && saved.log.length) {
      chatLog = saved.log;
      history = Array.isArray(saved.history) ? saved.history : [];
      body.innerHTML = '';
      chatLog.forEach((m) => renderOne(m.role, m.text));
      body.scrollTop = body.scrollHeight;
    } else {
      const saludo = body.querySelector('.chat-msg');
      chatLog = saludo ? [{ role: 'model', text: saludo.textContent }] : [];
    }
  })();

  function setOpen(open){
    widget.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
    panel.inert = !open;
    if (open) { opened = true; setTimeout(() => input.focus(), 200); }
  }
  toggle.addEventListener('click', () => setOpen(!widget.classList.contains('open')));
  closeBtn.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && widget.classList.contains('open')) setOpen(false);
  });

  function showTyping(){
    const row = document.createElement('div');
    row.className = 'chat-msg chat-msg-model chat-typing';
    row.id = 'chatTyping';
    row.innerHTML = '<span></span><span></span><span></span>';
    body.appendChild(row);
    body.scrollTop = body.scrollHeight;
  }
  function hideTyping(){
    const t = document.getElementById('chatTyping');
    if (t) t.remove();
  }

  function autosize(){
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 120) + 'px';
  }
  input.addEventListener('input', autosize);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = input.value.trim();
    if (!msg || sending) return;
    addMessage('user', msg);
    input.value = '';
    autosize();
    sending = true;
    sendBtn.disabled = true;
    showTyping();
    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: msg, history: history.slice(-16) }),
      });
      const data = await res.json().catch(() => ({}));
      hideTyping();
      const fallback = 'No pude procesar tu mensaje justo ahora. Intenta de nuevo en unos segundos.';
      if (!res.ok) {
        addMessage('model', data.reply || fallback);
      } else {
        addMessage('model', data.reply || fallback);
        history.push({ role: 'user', parts: [{ text: msg }] });
        history.push({ role: 'model', parts: [{ text: data.reply || '' }] });
      }
    } catch (err) {
      hideTyping();
      addMessage('model', 'Hay un problema de conexión. Intenta de nuevo en unos segundos.');
    } finally {
      sending = false;
      sendBtn.disabled = false;
    }
  });
})();
</script>
