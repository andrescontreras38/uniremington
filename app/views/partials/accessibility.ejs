<style>
/* Botón flotante en el lado opuesto a WhatsApp (izquierda), apilado encima de él —
   mismo criterio que el botón "volver arriba" en el lado derecho. */
.a11y-widget{position:fixed;left:20px;bottom:92px;z-index:76;font-family:inherit}
.a11y-toggle{width:54px;height:54px;border-radius:50%;border:0;cursor:pointer;
  background:#00457c;color:#fff;display:grid;place-items:center;box-shadow:0 6px 20px rgba(0,40,80,.4);
  transition:transform .15s,box-shadow .15s}
.a11y-toggle:hover{transform:scale(1.06);box-shadow:0 10px 26px rgba(0,40,80,.5)}
.a11y-toggle svg{width:30px;height:30px;display:block}

.a11y-panel{position:absolute;left:0;bottom:66px;width:280px;background:#fff;border-radius:16px;
  box-shadow:0 24px 60px rgba(0,40,80,.28);overflow:hidden;
  opacity:0;visibility:hidden;transform:translateY(12px) scale(.98);transform-origin:bottom left;
  transition:opacity .18s ease,transform .18s ease,visibility 0s linear .18s}
.a11y-panel.open{opacity:1;visibility:visible;transform:none;transition:opacity .18s ease,transform .18s ease}

.a11y-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:#00457c;color:#fff}
.a11y-head strong{font-size:.96rem}
.a11y-close{background:none;border:0;color:#fff;cursor:pointer;width:26px;height:26px;border-radius:50%;
  display:grid;place-items:center;font-size:1rem;line-height:1;flex:none}
.a11y-close:hover{background:rgba(255,255,255,.15)}

.a11y-body{padding:14px 16px;display:flex;flex-direction:column;gap:8px;max-height:min(60vh,420px);overflow-y:auto}
.a11y-row{display:flex;align-items:center;justify-content:space-between;font-size:.86rem;color:#1c2b38;padding:2px 2px 6px}
.a11y-stepper{display:flex;align-items:center;gap:6px}
.a11y-stepper button{width:28px;height:28px;border-radius:8px;border:1px solid #dbe3ec;background:#f5f8fa;
  cursor:pointer;font-weight:700;font-size:.8rem;color:#1c2b38}
.a11y-stepper button:hover{background:#e9eef5}
.a11y-stepper button:disabled{opacity:.4;cursor:default}
.a11y-stepper span{font-size:.78rem;color:#5b6b78;min-width:34px;text-align:center}

.a11y-toggle-btn{display:flex;align-items:center;justify-content:space-between;width:100%;padding:9px 12px;
  border:1px solid #dbe3ec;border-radius:10px;background:#f5f8fa;color:#1c2b38;font:inherit;font-size:.86rem;
  cursor:pointer;text-align:left;transition:background .15s,border-color .15s}
.a11y-toggle-btn::after{content:"";width:16px;height:16px;border-radius:50%;border:2px solid #c3ccd6;flex:none;
  transition:background .15s,border-color .15s}
.a11y-toggle-btn[aria-pressed="true"]{background:#eaf3fb;border-color:#00457c}
.a11y-toggle-btn[aria-pressed="true"]::after{background:#00457c;border-color:#00457c}

.a11y-reset{margin:4px 16px 14px;padding:9px;border:0;border-radius:10px;background:#e30613;color:#fff;
  font-weight:700;font-size:.84rem;cursor:pointer;transition:background .15s}
.a11y-reset:hover{background:#b0050f}

.a11y-note{font-size:.74rem;color:#5b6b78;line-height:1.4;padding:0 2px}

/* Traductor Google (en la misma página): el gadget se mantiene oculto y se controla por
   cookie desde los selectores .lang-select del menú. Se oculta también la barra superior
   de Google y se evita que empuje el body, y el resaltado del texto traducido. */
#google_translate_element{display:none!important}
/* La barra superior de Google cambia de clase entre versiones; se oculta por su clase
   estable "skiptranslate" (hija directa de body) además de los nombres clásicos. */
body>.skiptranslate,iframe.skiptranslate,.goog-te-banner-frame,.goog-te-gadget-icon,.goog-tooltip,.goog-te-balloon-frame,#goog-gt-tt{display:none!important}
.goog-te-gadget{height:0;overflow:hidden}
body{top:0!important;position:static!important}
html.translated-ltr,html.translated-rtl{margin-top:0!important}
.goog-text-highlight{background:none!important;box-shadow:none!important}

/* Resalta el bloque de texto que se está por leer (o leyendo) al pasar el mouse
   por encima, para que se vea claramente qué va a sonar. */
.a11y-tts-hovering{outline:2px solid #00457c!important;outline-offset:2px;border-radius:3px}

@media (max-width:480px){
  .a11y-widget{left:14px;bottom:86px}
  .a11y-panel{width:min(280px,calc(100vw - 28px))}
}

/* En ESCRITORIO (>=1361px) la accesibilidad se abre desde el botón del menú principal
   (#navA11y): se oculta la burbuja flotante y el panel baja desde la esquina superior
   derecha, junto a ese botón. En móvil/tablet se mantiene la burbuja flotante. */
@media (min-width:1361px){
  .a11y-widget{z-index:320}   /* por encima del navbar (300) para que el panel no quede detrás */
  .a11y-toggle{display:none}
  .a11y-panel{
    position:fixed;top:72px;right:24px;left:auto;bottom:auto;
    transform-origin:top right;
  }
}
</style>

<div class="a11y-widget" id="a11yWidget">
  <button type="button" class="a11y-toggle" id="a11yToggle" aria-haspopup="dialog" aria-expanded="false"
          aria-controls="a11yPanel" aria-label="Herramientas de accesibilidad">
    <!-- Mismo ícono de línea que la insignia del header (navbar.ejs, A11Y_SVG): antes era
         una figura sólida rellena, inconsistente con el resto de íconos de línea del sitio. -->
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <circle cx="12" cy="8.2" r="1.15" fill="currentColor" stroke="none"></circle>
      <path d="M8.3 10.6c1.15.55 2.4.85 3.7.85s2.55-.3 3.7-.85"></path>
      <path d="M12 11.4v3.1"></path>
      <path d="M12 14.5l-2.1 4.3"></path>
      <path d="M12 14.5l2.1 4.3"></path>
    </svg>
  </button>

  <div class="a11y-panel" id="a11yPanel" role="dialog" aria-label="Herramientas de accesibilidad" inert>
    <div class="a11y-head">
      <strong>Accesibilidad</strong>
      <button type="button" class="a11y-close" id="a11yClose" aria-label="Cerrar herramientas de accesibilidad">&#10005;</button>
    </div>
    <div class="a11y-body">
      <div class="a11y-row">
        <span>Tamaño de texto</span>
        <div class="a11y-stepper">
          <button type="button" data-a11y="fs-dec" aria-label="Reducir tamaño de texto">A&minus;</button>
          <span id="a11yFsLabel">100%</span>
          <button type="button" data-a11y="fs-inc" aria-label="Aumentar tamaño de texto">A+</button>
        </div>
      </div>
      <button type="button" class="a11y-toggle-btn" data-a11y="contrast" aria-pressed="false">Alto contraste</button>
      <button type="button" class="a11y-toggle-btn" data-a11y="gray" aria-pressed="false">Escala de grises</button>
      <button type="button" class="a11y-toggle-btn" data-a11y="underline" aria-pressed="false">Subrayar enlaces</button>
      <button type="button" class="a11y-toggle-btn" data-a11y="readable" aria-pressed="false">Espaciado de lectura</button>
      <button type="button" class="a11y-toggle-btn" data-a11y="nomotion" aria-pressed="false">Pausar animaciones</button>
      <button type="button" class="a11y-toggle-btn" id="a11yTtsPageBtn" aria-pressed="false">Leer esta página</button>
      <button type="button" class="a11y-toggle-btn" id="a11yTtsHoverBtn" data-a11y="ttsHover" aria-pressed="false">Leer al pasar el mouse</button>
      <p class="a11y-note" id="a11yTtsHoverNote">Con esto activo, pasa el mouse sobre cualquier texto del sitio y se lee solo, sin necesidad de hacer clic.</p>
    </div>
    <button type="button" class="a11y-reset" id="a11yReset">Restablecer todo</button>
  </div>
  <!-- Host del traductor de Google (oculto): se rellena solo si el usuario elige idioma. -->
  <div id="google_translate_element" aria-hidden="true"></div>
</div>

<script>
(function () {
  var KEY = 'a11yPrefs';
  var root = document.documentElement;
  var widget = document.getElementById('a11yWidget');
  if (!widget) return;
  var toggle = document.getElementById('a11yToggle');
  var panel = document.getElementById('a11yPanel');
  var closeBtn = document.getElementById('a11yClose');
  var resetBtn = document.getElementById('a11yReset');
  var fsLabel = document.getElementById('a11yFsLabel');
  var FS_PCT = { 1: '100%', 2: '112%', 3: '125%', 4: '137%' };
  var TOGGLE_KEYS = ['contrast', 'gray', 'underline', 'readable', 'nomotion', 'ttsHover'];
  var setTtsHoverEnabled = function () {}; // se reemplaza más abajo si el navegador soporta lectura en voz alta

  function load() { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { return {}; } }
  function save(s) { try { localStorage.setItem(KEY, JSON.stringify(s)); } catch (e) {} }

  var state = load();
  if (!state.fs) state.fs = 1;

  function applyAll() {
    root.classList.remove('a11y-fs2', 'a11y-fs3', 'a11y-fs4');
    if (state.fs > 1) root.classList.add('a11y-fs' + state.fs);
    TOGGLE_KEYS.forEach(function (key) {
      root.classList.toggle('a11y-' + key, !!state[key]);
      var btn = widget.querySelector('[data-a11y="' + key + '"]');
      if (btn) btn.setAttribute('aria-pressed', state[key] ? 'true' : 'false');
    });
    if (fsLabel) fsLabel.textContent = FS_PCT[state.fs];
    setTtsHoverEnabled(!!state.ttsHover);
  }

  // ── Leer en voz alta (síntesis de voz nativa del navegador: sin librerías ni
  // peticiones de red). "Leer esta página" lee todo el contenido con un clic — para
  // quien no puede pasar el mouse por texto específico. Con el interruptor "Leer al
  // pasar el mouse" activo, pasar el cursor sobre cualquier texto del sitio (sin
  // clic, sin seleccionar) lo lee automáticamente tras un breve instante. ──
  var TTS = window.speechSynthesis;
  var ttsPageBtn = document.getElementById('a11yTtsPageBtn');
  var ttsHoverBtn = document.getElementById('a11yTtsHoverBtn');
  var ttsHoverNote = document.getElementById('a11yTtsHoverNote');
  if (!TTS || typeof SpeechSynthesisUtterance === 'undefined') {
    // Sin soporte: se ocultan en vez de ofrecer botones que no van a funcionar.
    if (ttsPageBtn) ttsPageBtn.remove();
    if (ttsHoverBtn) ttsHoverBtn.remove();
    if (ttsHoverNote) ttsHoverNote.remove();
    var idx = TOGGLE_KEYS.indexOf('ttsHover');
    if (idx !== -1) TOGGLE_KEYS.splice(idx, 1);
  } else {
    // Voz latina en vez de la española por defecto del navegador: se busca entre
    // las voces instaladas, primero Colombia (sede de Uniremington), luego
    // cualquier otra variante latinoamericana. Entre varias candidatas del mismo
    // nivel, se prioriza una voz de nombre femenino conocido (Sabina, Paulina...)
    // — resultó sonar más familiar/cercana que dejar que gane la de mejor calidad
    // técnica (p. ej. una voz de Google), aunque esa suene más "natural" en
    // aislado. La lista de voces se carga async en algunos navegadores, por eso
    // se recalcula también en "voiceschanged".
    var FEMALE_NAME_HINTS = /sabina|paulina|mónica|monica|elena|lucía|lucia|camila|valentina|isabela|maría|maria|paloma|female/i;
    var latinVoice = null;
    function pickLatinVoice() {
      var voices = TTS.getVoices() || [];
      var esVoices = voices.filter(function (v) { return /^es/i.test(v.lang); });
      var tier = function (re) { return esVoices.filter(function (v) { return re.test(v.lang); }); };
      var candidates = tier(/^es-CO/i);
      if (!candidates.length) candidates = tier(/^es-(MX|US|AR|CL|PE|VE|EC|UY|PY|BO|GT|CR|PA|DO|HN|SV|NI|419)/i);
      if (!candidates.length) candidates = esVoices.filter(function (v) { return !/^es-ES/i.test(v.lang); });
      if (!candidates.length) candidates = esVoices;
      var female = candidates.find(function (v) { return FEMALE_NAME_HINTS.test(v.name); });
      latinVoice = female || candidates[0] || null;
    }
    pickLatinVoice();
    if (TTS.addEventListener) TTS.addEventListener('voiceschanged', pickLatinVoice);

    // innerText convierte cada <br> en un simple "\n" — si se trocea por cualquier
    // salto de línea, una frase partida a mitad por un <br> (muy común en textos
    // importados) sonaba con una pausa donde no debía haberla. Aquí un salto de
    // línea SUELTO se trata como continuación de la misma frase (solo un espacio);
    // únicamente un salto DOBLE (separación real entre párrafos/bloques) se trata
    // como el fin de una idea y sí introduce una pausa.
    function normalizeForSpeech(text) {
      return text
        .replace(/\r\n/g, '\n')
        .replace(/[ \t]+/g, ' ')
        .replace(/\n{2,}/g, '. ')
        .replace(/\n/g, ' ')
        .replace(/ {2,}/g, ' ')
        .trim();
    }

    // Trocea un texto por frase (puntuación real, no saltos de línea) — necesario
    // porque Chrome corta los textos muy largos a los ~15s si se manda todo de una
    // sola vez en un solo utterance.
    function textToChunks(text) {
      var norm = normalizeForSpeech(text);
      return (norm.match(/[^.!?]+[.!?]*/g) || [norm]).map(function (c) { return c.trim(); }).filter(Boolean);
    }
    function queueChunks(queued) {
      if (!queued.length) return;
      queued.forEach(function (chunk, i) {
        var u = new SpeechSynthesisUtterance(chunk);
        if (latinVoice) { u.voice = latinVoice; u.lang = latinVoice.lang; }
        else { u.lang = 'es-MX'; }
        u.volume = 1;
        // Un poco más rápida que el ritmo por defecto, para que no se sienta lenta
        // de escuchar. El tono se deja en su valor natural: forzarlo sonaba bien en
        // voces locales robóticas, pero en una voz de red ya natural (ver arriba)
        // ese ajuste manual se nota como un artificio y la hace sonar peor.
        u.rate = 1.12;
        if (i === 0) u.onstart = onSpeakStart;
        if (i === queued.length - 1) { u.onend = onSpeakEnd; u.onerror = onSpeakEnd; }
        TTS.speak(u);
      });
    }
    // Lee un solo bloque de texto (lo que usa el hover: siempre una única unidad legible).
    function speak(text) {
      if (!text) return;
      TTS.cancel();
      queueChunks(textToChunks(text));
    }
    // Elementos que representan una unidad de contenido propia (párrafo, título,
    // ítem de lista, celda...). Cada uno se lee como utterance(s) independiente(s),
    // así que entre un bloque y el siguiente sí queda una pausa real — a diferencia
    // de leer todo el <main> como un solo texto aplanado, donde esa frontera entre
    // párrafos/secciones se perdía y todo sonaba corrido.
    var BLOCK_SELECTOR = 'h1,h2,h3,h4,h5,h6,p,li,blockquote,figcaption,dt,dd,td,th,caption';
    function hasBlockAncestor(el, root) {
      var p = el.parentElement;
      while (p && p !== root) {
        if (p.matches(BLOCK_SELECTOR)) return true;
        p = p.parentElement;
      }
      return false;
    }
    function collectReadableBlocks(root) {
      var blocks = [];
      root.querySelectorAll(BLOCK_SELECTOR).forEach(function (el) {
        if (widget.contains(el)) return;
        if (hasBlockAncestor(el, root)) return; // ya se lee dentro de un bloque que lo contiene
        var cs = getComputedStyle(el);
        if (cs.display === 'none' || cs.visibility === 'hidden') return;
        var text = (el.innerText || el.textContent || '').trim();
        if (text) blocks.push(text);
      });
      return blocks;
    }
    // Lee varios bloques en orden, cada uno con su propia frontera de pausa.
    function speakBlocks(texts) {
      TTS.cancel();
      var allChunks = [];
      texts.forEach(function (t) {
        var chunks = textToChunks(t);
        if (!chunks.length) return;
        // Cierra cada bloque con puntuación clara aunque el texto original no
        // termine en punto (p. ej. un enlace corto como "Ver más"), para que la
        // pausa entre bloques se note igual de bien en todos los casos.
        var last = chunks[chunks.length - 1];
        if (!/[.!?]$/.test(last)) chunks[chunks.length - 1] = last + '.';
        allChunks = allChunks.concat(chunks);
      });
      queueChunks(allChunks);
    }
    function stopSpeaking() { TTS.cancel(); onSpeakEnd(); }
    function onSpeakStart() {
      if (ttsPageBtn) { ttsPageBtn.textContent = 'Detener lectura'; ttsPageBtn.setAttribute('aria-pressed', 'true'); }
    }
    function onSpeakEnd() {
      if (ttsPageBtn) { ttsPageBtn.textContent = 'Leer esta página'; ttsPageBtn.setAttribute('aria-pressed', 'false'); }
    }

    if (ttsPageBtn) {
      ttsPageBtn.textContent = 'Leer esta página';
      ttsPageBtn.addEventListener('click', function () {
        if (TTS.speaking) { stopSpeaking(); return; }
        var main = document.querySelector('main') || document.body;
        var blocks = collectReadableBlocks(main);
        speakBlocks(blocks.length ? blocks : [main.innerText]);
      });
    }

    // Se limita a elementos que típicamente contienen una unidad de texto legible
    // (párrafo, ítem de lista, título, enlace...) y no a contenedores grandes tipo
    // <div>/<section>, para no leer bloques enteros de golpe al pasar por encima.
    var HOVER_SELECTOR = 'p,li,h1,h2,h3,h4,h5,h6,a,span,td,th,blockquote,figcaption,dt,dd,label,button,strong,em,small,caption';
    var HOVER_DELAY = 450; // ms que el mouse debe quedarse quieto sobre el mismo bloque antes de leerlo
    var ttsHoverActive = false, hoverTimer = null, hoverEl = null;

    function closestReadable(el) {
      while (el && el.nodeType === 1 && el !== document.body) {
        if (widget.contains(el)) return null; // no leer los controles del propio widget
        if (el.matches(HOVER_SELECTOR)) return el;
        el = el.parentElement;
      }
      return null;
    }
    function clearHoverVisual() {
      if (hoverEl) hoverEl.classList.remove('a11y-tts-hovering');
      hoverEl = null;
    }
    function onMouseOver(e) {
      if (!ttsHoverActive) return;
      var el = closestReadable(e.target);
      if (!el || el === hoverEl) return;
      clearTimeout(hoverTimer);
      clearHoverVisual();
      hoverEl = el;
      el.classList.add('a11y-tts-hovering');
      hoverTimer = setTimeout(function () {
        var text = (el.innerText || el.textContent || '').trim();
        if (text) speak(text);
      }, HOVER_DELAY);
    }
    function onMouseOut(e) {
      if (!ttsHoverActive) return;
      var el = closestReadable(e.target);
      if (el === hoverEl && (!e.relatedTarget || closestReadable(e.relatedTarget) !== el)) {
        clearTimeout(hoverTimer);
        clearHoverVisual();
      }
    }
    function onClickWhileHover() {
      if (ttsHoverActive) stopSpeaking();
    }

    setTtsHoverEnabled = function (on) {
      ttsHoverActive = on;
      if (!on) { clearTimeout(hoverTimer); clearHoverVisual(); stopSpeaking(); }
    };
    document.addEventListener('mouseover', onMouseOver);
    document.addEventListener('mouseout', onMouseOut);
    document.addEventListener('mousedown', onClickWhileHover);
  }

  applyAll();

  function openPanel() {
    // Se asigna la propiedad IDL (no removeAttribute/setAttribute) y el foco se difiere
    // 200ms (mismo patrón ya probado en chat-widget.ejs): quitar "inert" no deja el
    // subárbol enfocable de forma fiable en el mismo turno síncrono.
    panel.inert = false;
    panel.classList.add('open');
    toggle.setAttribute('aria-expanded', 'true');
    setTimeout(function () {
      var first = panel.querySelector('button');
      if (first) first.focus();
    }, 200);
    document.addEventListener('keydown', onKey);
    document.addEventListener('click', onOutside, true);
  }
  function closePanel(returnFocus) {
    panel.classList.remove('open');
    panel.inert = true;
    toggle.setAttribute('aria-expanded', 'false');
    document.removeEventListener('keydown', onKey);
    document.removeEventListener('click', onOutside, true);
    if (returnFocus !== false) toggle.focus();
  }
  function onKey(e) { if (e.key === 'Escape') closePanel(); }
  // El botón de accesibilidad del menú principal (#navA11y) vive fuera del widget;
  // no debe contar como "clic fuera" o se cerraría y volvería a abrirse en bucle.
  function onOutside(e) { if (!widget.contains(e.target) && !e.target.closest('#navA11y')) closePanel(false); }

  toggle.addEventListener('click', function () {
    if (panel.classList.contains('open')) closePanel(); else openPanel();
  });
  closeBtn.addEventListener('click', function () { closePanel(); });

  widget.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-a11y]');
    if (!btn) return;
    var key = btn.dataset.a11y;
    if (key === 'fs-inc') { state.fs = Math.min(4, (state.fs || 1) + 1); }
    else if (key === 'fs-dec') { state.fs = Math.max(1, (state.fs || 1) - 1); }
    else { state[key] = !state[key]; }
    save(state);
    applyAll();
  });

  resetBtn.addEventListener('click', function () {
    state = { fs: 1 };
    save(state);
    applyAll();
  });
})();
</script>

<script>
(function () {
  // Traductor en la MISMA página con Google Translate (mismo enfoque que EAFIT). No se
  // descarga NADA salvo que el usuario elija un idioma; se guarda en la cookie googtrans y
  // persiste al navegar. La traducción es 100% cliente sobre la misma URL: sin URLs
  // alternas ni hreflang, así que los buscadores solo indexan el español (sin doble
  // indexación) y no cuesta nada a quien no lo usa. Los selectores viven en el menú.
  var sels = document.querySelectorAll('.lang-select');
  if (!sels.length) return;

  function getCookie(n) { var m = document.cookie.match('(?:^|; )' + n + '=([^;]*)'); return m ? decodeURIComponent(m[1]) : ''; }
  function currentLang() { var m = getCookie('googtrans').match(/\/(?:es|auto)\/([\w-]+)/); return m ? m[1] : 'es'; }
  function setGoogtrans(lang) {
    var val = lang ? ('/es/' + lang) : '';
    var expire = lang ? '' : 'expires=Thu, 01 Jan 1970 00:00:00 GMT;';
    document.cookie = 'googtrans=' + val + ';path=/;' + expire;
    var parts = location.hostname.split('.');
    if (parts.length > 2) {
      var root = '.' + parts.slice(-2).join('.');
      document.cookie = 'googtrans=' + val + ';path=/;domain=' + root + ';' + expire;
    }
  }

  var loaded = false;
  window.googleTranslateElementInit = function () {
    try { new google.translate.TranslateElement({ pageLanguage: 'es', autoDisplay: false }, 'google_translate_element'); } catch (e) {}
  };
  function loadGT() {
    if (loaded) return; loaded = true;
    var s = document.createElement('script');
    s.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
    s.async = true;
    document.body.appendChild(s);
  }

  var cur = currentLang();
  sels.forEach(function (sel) {
    sel.value = cur;
    sel.addEventListener('change', function () {
      setGoogtrans(sel.value === 'es' ? '' : sel.value);
      // Recargar: al cargar, el widget lee la cookie y aplica (o revierte) la traducción.
      // Es la vía más fiable y mantiene el idioma elegido al navegar por el resto del sitio.
      location.reload();
    });
  });

  // Refuerzo para ocultar la barra superior de Google (por si su clase varía) y evitar que
  // empuje el header. Se ejecuta SOLO cuando la página está traducida, así que no cuesta
  // nada a quien no usa el traductor ni a los buscadores.
  function hideGoogleBanner() {
    document.querySelectorAll('body > .skiptranslate, iframe.skiptranslate, .goog-te-banner-frame').forEach(function (el) {
      el.style.setProperty('display', 'none', 'important');
    });
    if (document.body) document.body.style.setProperty('top', '0', 'important');
  }

  // Si en una visita previa se eligió idioma (cookie presente), aplica la traducción en
  // esta página cargando el widget. Solo para quien optó; nunca para los buscadores.
  if (cur !== 'es') {
    loadGT();
    hideGoogleBanner();
    // El banner se inserta un instante después de traducir: se limpia unos segundos y con
    // un observer acotado (hijos directos de body), que se desconecta enseguida. Barato.
    var kills = 0, iv = setInterval(function () { hideGoogleBanner(); if (++kills > 24) clearInterval(iv); }, 250);
    try {
      var mo = new MutationObserver(hideGoogleBanner);
      mo.observe(document.body, { childList: true });
      setTimeout(function () { mo.disconnect(); }, 8000);
    } catch (e) {}
  }
})();
</script>
