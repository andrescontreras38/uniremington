      const posts = await res.json();
      if (!posts.length) return;
      const container = document.getElementById(id);
      const principal = posts[0];
      const secundarios = posts.slice(1, 5);
      const moreUrl = ACT_MORE[id] || "/noticias";
      var ICON_D = {
        event: 'M580 240Q538 240 509 269Q480 298 480 340Q480 382 509 411Q538 440 580 440Q622 440 651 411Q680 382 680 340Q680 298 651 269Q622 240 580 240ZM120 80V800H240V880H320V800H640V880H720V800H840V80ZM200 160H760V560H200ZM200 640H760V720H200Z',
        newspaper: 'M80 120V840L147 773L213 840L280 773L347 840L413 773L480 840L547 773L613 840L680 773L747 840L813 773L880 840V120ZM160 200H440V440H160ZM520 200H800V280H520ZM520 360H800V440H520ZM160 520H800V640H160Z'
