            ? '<img src="' + esc(p.img) + '" alt="' + esc(p.title) + '"' + (eager ? '' : ' loading="lazy"') + '>'
            : '<span class="ph"><svg class="ico" viewBox="0 0 960 960" aria-hidden="true"><path transform="matrix(1 0 0 -1 0 960)" d="' + ICON_D[p.tag === 'Eventos' ? 'event' : 'newspaper'] + '"/></svg><b>Uniremington</b></span>') +
