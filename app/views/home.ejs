    @media (max-width: 900px) {
      .foot-grid {
        grid-template-columns: 1fr 1fr;
      }

      .foot-brand {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 520px) {
      .foot-grid {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .foot-bottom {
        flex-direction: column;
        text-align: center;
      }
    }

    .muted {
      color: var(--muted)
    }

    /* --- Estilos para la sección Actualidad Uniremington --- */
    .act-container {
      margin: auto;
      padding: 20px;
    }

    .act-container h2 {
      text-align: center;
      font-size: 2rem;
      margin-bottom: 20px;
      color: #002b5c;
    }

    .act-tabs {
      display: flex;
      justify-content: center;
      gap: 30px;
      margin-bottom: 25px;
    }

    .act-tabs button {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1rem;
      font-weight: 600;
      padding-bottom: 5px;
      color: var(--muted);
    }

    .act-tabs button.active {
      color: var(--accent);
      border-bottom: 2px solid var(--accent);
    }

    .act-tab-content {
      display: none;
    }

    .act-tab-content.active {
      display: block;
    }

    /* Estructura: destacada horizontal arriba + fila de tarjetas debajo */
    .act-grid {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    /* Etiqueta flotante sobre la imagen (compartida por destacada y tarjetas) */
    .act-tag {
      position: absolute;
      top: 12px; left: 12px;
      z-index: 2;
      background: var(--accent);
      color: #fff;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: .03em;
      text-transform: uppercase;
      box-shadow: 0 4px 12px rgba(227, 7, 21, 0.35);
    }
    .act-media { position: relative; display: block; overflow: hidden; }
    .act-media img { transition: transform .55s ease; }
    /* Overlay azul institucional leve para reforzar la identidad de marca */
    .act-media::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(180deg, rgba(0, 69, 124, 0.10) 0%, rgba(0, 69, 124, 0.22) 100%);
      pointer-events: none;
      transition: opacity .3s ease;
    }
    .act-principal:hover .act-media::after,
    .act-card:hover .act-media::after { opacity: .6; }

    /* Placeholder de marca cuando la noticia/evento no trae imagen real — evita mostrar
       una foto genérica repetida en varias tarjetas distintas (se ve como contenido roto). */
    .act-media .ph {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
      width: 100%; height: 100%; background: linear-gradient(135deg, #012a50, #0a5aa8); color: #fff;
      text-align: center; padding: 16px; position: relative; overflow: hidden;
    }
    .act-media .ph::after {
      content: ""; position: absolute; inset: 0;
      background: repeating-linear-gradient(135deg, rgba(255,255,255,.05) 0 2px, transparent 2px 22px);
    }
    .act-media .ph .ico { font-size: 2.4rem; opacity: .9; position: relative; z-index: 1; }
    .act-media .ph b { font-size: .74rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
      color: #cfe0f5; position: relative; z-index: 1; }
    .act-principal .act-media .ph { min-height: 260px; max-height: 340px; }
    .act-card .act-media .ph { height: 150px; }
    .act-card .act-media .ph .ico { font-size: 2rem; }

    /* --- Destacada horizontal --- */
    .act-principal {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      background: #fff;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 24px 50px -22px rgba(0, 40, 80, 0.45), 0 6px 16px -8px rgba(0, 40, 80, 0.2);
      transition: box-shadow 0.3s, transform 0.3s;
    }
    .act-principal:hover {
      transform: translateY(-3px);
      box-shadow: 0 32px 60px -24px rgba(0, 40, 80, 0.5), 0 8px 20px -8px rgba(0, 40, 80, 0.24);
    }
    .act-principal .act-media { height: 100%; }
    .act-principal .act-media img {
      width: 100%;
      height: 100%;
      min-height: 260px;
      max-height: 340px;
      object-fit: cover;
    }
    .act-principal:hover .act-media img { transform: scale(1.05); }

    .act-principal .contenido {
      padding: 30px 32px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .act-principal h3 {
      margin: 0 0 12px;
      font-size: 1.5rem;
      line-height: 1.22;
      color: #002b5c;
      text-wrap: balance;
    }
    .act-principal h3 a,
    .act-card h4 a { color: inherit; text-decoration: none; }
    .act-principal h3 a:hover,
    .act-card h4 a:hover { color: var(--accent); }

    .act-resumen {
      margin: 0;
      color: #54606e;
      line-height: 1.55;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .act-principal .act-resumen {
      font-size: 1rem;
      -webkit-line-clamp: 4;
      line-clamp: 4;
    }

    .act-foot {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 20px;
      font-size: 0.86rem;
      flex-wrap: wrap;
    }
    .act-foot time { color: var(--muted); font-weight: 600; }
    .act-leer {
      color: var(--accent);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }
    .act-leer:hover { text-decoration: underline; }

    /* --- Fila de tarjetas --- */
    .act-cards {
      display: grid;
