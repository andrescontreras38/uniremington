  <script>
    // Año dinámico en el footer
    const footerYear = document.getElementById('footer-year');
    if (footerYear) footerYear.textContent = new Date().getFullYear();

    // El correo no va como texto plano en el HTML (evita que bots de spam lo cosechen
    // con un regex simple); se arma en el navegador a partir de dos atributos separados.
    document.querySelectorAll('.email-link[data-u]').forEach((a) => {
      const addr = a.dataset.u + '@' + a.dataset.d;
      a.href = 'mailto:' + addr;
      const tx = a.querySelector('.email-tx');
      if (tx) tx.textContent = addr;
    });

    // Video thumbnail → iframe al hacer clic
    const videoThumb = document.getElementById('videoThumb');
    if (videoThumb) {
      const reproducirVideo = () => {
        const id = videoThumb.dataset.video;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = 'Video Institucional';
        iframe.allow = 'autoplay; encrypted-media';
        iframe.allowFullscreen = true;
        videoThumb.replaceWith(iframe);
      };
      videoThumb.addEventListener('click', reproducirVideo);
      videoThumb.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); reproducirVideo(); }
      });
    }

    // Hero bento: spotlight que sigue al cursor + leve tilt 3D en la celda de media.
    // El resto del bento no rota (todo el contenido institucional está siempre visible);
    // solo la celda de media tiene un pequeño carrusel propio (ver más abajo).
    (function () {
      const hero = document.getElementById('hero');
      if (!hero) return;
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hasHover = window.matchMedia('(hover: hover)').matches;
      if (prefersReduced || !hasHover) return;

      hero.querySelectorAll('.bento-cell').forEach((cell) => {
        cell.addEventListener('mousemove', (e) => {
          const r = cell.getBoundingClientRect();
          cell.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100).toFixed(1) + '%');
          cell.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100).toFixed(1) + '%');
        });
      });

      const media = hero.querySelector('.bento-media');
      const viewport = media && media.querySelector('.bm-viewport');
      if (media && viewport) {
        media.addEventListener('mousemove', (e) => {
          const r = media.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width - 0.5;
          const py = (e.clientY - r.top) / r.height - 0.5;
          viewport.style.transform = 'perspective(800px) rotateX(' + (py * -6).toFixed(2) + 'deg) rotateY(' + (px * 8).toFixed(2) + 'deg)';
        });
        media.addEventListener('mouseleave', () => { viewport.style.transform = ''; });
      }
    })();

    // Celda de media: mini-carrusel de ofertas de Mercadeo (piezas gráficas reales).
    // Autoplay corto, pausa al pasar el mouse/foco o con el botón play/pausa,
    // y respeta prefers-reduced-motion (sin avance automático; solo navegación manual).
    (function () {
      const media = document.getElementById('bentoMedia');
      if (!media) return;
      const slides = [...media.querySelectorAll('.bm-slide')];
      const dots = [...media.querySelectorAll('.bm-dot')];
      if (slides.length < 2) return;

      // Las imágenes de las diapositivas 2+ no llevan src de entrada (ver arriba): se
      // cargan aquí cuando el navegador ya está libre, para no competir por ancho de
      // banda con la imagen del LCP (diapositiva 1) durante el arranque.
      function loadDeferredSlideImages() {
        slides.forEach((s) => {
          const img = s.querySelector('img[data-src]');
          if (img) {
            if (img.dataset.srcset) { img.srcset = img.dataset.srcset; img.removeAttribute('data-srcset'); }
            img.src = img.dataset.src; img.removeAttribute('data-src');
          }
        });
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadDeferredSlideImages, { timeout: 3000 });
      } else {
        setTimeout(loadDeferredSlideImages, 2000);
      }

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const DURATION = 4500;
      let current = 0;
      let timer = null;
      let userPaused = prefersReduced;

      function goTo(index) {
        const next = (index + slides.length) % slides.length;
        if (next === current) return;
        slides[current].classList.remove('is-active');
        dots[current].classList.remove('is-active');
        dots[current].setAttribute('aria-selected', 'false');
        current = next;
        slides[current].classList.add('is-active');
        dots[current].classList.add('is-active');
        dots[current].setAttribute('aria-selected', 'true');
      }

      dots.forEach((d, i) => d.addEventListener('click', () => { goTo(i); restart(); }));

      const prevBtn = media.querySelector('.bm-arrow-prev');
      const nextBtn = media.querySelector('.bm-arrow-next');
      if (prevBtn) prevBtn.addEventListener('click', () => { goTo(current - 1); restart(); });
      if (nextBtn) nextBtn.addEventListener('click', () => { goTo(current + 1); restart(); });

      function start() {
        stop();
        if (userPaused) return;
        timer = setInterval(() => goTo(current + 1), DURATION);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function restart() { start(); }

      // Pausa temporal al pasar el mouse/foco (no cambia la preferencia del usuario)
      media.addEventListener('mouseenter', stop);
      media.addEventListener('mouseleave', () => { if (!userPaused) start(); });
      media.addEventListener('focusin', stop);
      media.addEventListener('focusout', (e) => { if (!userPaused && !media.contains(e.relatedTarget)) start(); });

      // Botón play/pausa: control explícito y persistente del avance automático
      const playBtn = media.querySelector('.bm-play');
      if (playBtn) {
        const PAUSE_D = 'M520 200V760H760V200ZM200 200V760H440V200Z';
        const PLAY_D = 'M320 200V760L760 480ZM400 346 610 480 400 614Z';
        const syncPlayBtn = () => {
          playBtn.querySelector('.ico path').setAttribute('d', userPaused ? PLAY_D : PAUSE_D);
          playBtn.setAttribute('aria-pressed', String(!userPaused));
          playBtn.setAttribute('aria-label', userPaused ? 'Reanudar avance automático' : 'Pausar avance automático');
        };
        syncPlayBtn();
        playBtn.addEventListener('click', () => {
          userPaused = !userPaused;
          syncPlayBtn();
          if (userPaused) stop(); else start();
        });
      }

      start();
    })();
  </script>

  <!-- JS Actualidad Uniremingtong -->
  <script>
