  <%- include('partials/navbar') %>

  <!-- Header (solo HERO) -->
  <header>

    <%
      // Ofertas de Mercadeo (piezas gráficas reales, campañas vigentes de lanzamiento de
      // posgrados): solo 2-3, pequeñas, integradas como celdas más del propio bento -no
      // una sección/carrusel aparte-. Mercadeo rota estas piezas seguido; para cambiar
      // cuáles se muestran aquí, solo se edita este arreglo.
      var campaigns = [
        { img: '/media/campanas/maestria-ciencias-salud.webp',
          href: 'https://apps.clientify.net/forms/simpleembed/#/forms/embedform/277097/105053', external: true,
          label: 'Maestría en Ciencias de la Salud' },
        { img: '/media/campanas/maestria-clinica-veterinaria.webp',
          href: 'https://apps.clientify.net/forms/simpleembed/#/forms/embedform/277098/105053', external: true,
          label: 'Maestría en Clínica y Cirugía Veterinaria' },
        { img: '/media/campanas/maestria-administracion.webp',
          href: '/facultades/facultad-de-ciencias-empresariales/maestria-en-administracion/', external: false,
          label: 'Maestría en Administración' },
      ];
      // Variante 640px (generada con sharp junto a la original 1100px): en móvil esta
      // celda mide ~354px CSS (~620px físicos con DPR 1.75, medido en el propio Lighthouse
      // móvil), así que servir la de 1100px ahí desperdicia ~49 KiB por imagen.
      var campaignSrcset = function (img) {
        return img.replace('.webp', '-640.webp') + ' 640w, ' + img + ' 1100w';
      };
      var campaignSizes = '(max-width: 768px) 90vw, (max-width: 1024px) 45vw, 550px';
    %>

    <!-- Hero: bento grid (sin carrusel). Todo el contenido real visible a la vez. -->
    <div class="hero" id="hero">
      <div class="hero-aurora" aria-hidden="true"><span></span><span></span><span></span></div>

      <div class="bento">
        <div class="bento-cell bento-headline">
          <span class="hero-badge">Inscripciones abiertas 2026</span>
          <h1>Transforma realidades con <span class="accent">conocimiento y educación de alta pertinencia</span></h1>
          <p>Más de un siglo de historia educativa formando profesionales íntegros, comprometidos con la transformación social del país.</p>
          <a href="/programas" class="cta-hero">Explorar Programas &rarr;</a>
          <div class="bento-meta">
            <div><div class="stat-num">+30</div><div class="stat-label">Años Corporación</div></div>
            <div><div class="stat-num">+110</div><div class="stat-label">Años Educativos</div></div>
            <div><div class="stat-num">+80</div><div class="stat-label">Programas</div></div>
          </div>
        </div>

        <!-- Celda media: mini-carrusel de ofertas de Mercadeo -->
        <div class="bento-cell bento-media" id="bentoMedia">
          <div class="bm-viewport">
            <% campaigns.forEach(function(c, i){ %>
            <div class="bm-slide<%= i === 0 ? ' is-active' : '' %>" data-slide="<%= i %>" id="bm-panel-<%= i %>" role="tabpanel" aria-labelledby="bm-tab-<%= i %>">
              <a class="bm-linkfull" href="<%= c.href %>"<% if (c.external) { %> target="_blank" rel="noopener"<% } %> aria-label="<%= c.label %>">
                <% if (i === 0) { %>
                <img src="<%= c.img %>" srcset="<%= campaignSrcset(c.img) %>" sizes="<%= campaignSizes %>" alt="<%= c.label %>" width="1100" height="779" loading="eager" fetchpriority="high" decoding="async">
                <% } else { %>
                <!-- data-src/data-srcset (sin src): las diapositivas inactivas están en
                     position:absolute con el mismo tamaño del viewport (para el crossfade),
                     así que aunque lleven loading="lazy" el navegador las considera "cerca" y
                     las descarga igual — se cargan por JS más abajo, tras el LCP. -->
                <img data-src="<%= c.img %>" data-srcset="<%= campaignSrcset(c.img) %>" sizes="<%= campaignSizes %>" alt="<%= c.label %>" width="1100" height="779" decoding="async">
                <% } %>
                <span class="bento-media-cap"><%= c.label %></span>
              </a>
            </div>
            <% }) %>
