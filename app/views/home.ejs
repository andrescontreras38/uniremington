<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Corporación Universitaria Remington — Universidad Colombiana</title>
  <% var _desc = (typeof desc !== 'undefined' && desc) ? desc : 'Más de 100 años formando profesionales en Colombia, con 19 sedes. Programas de pregrado, posgrado y educación continua, presenciales y a distancia.'; %>
  <meta name="description" content="<%= _desc %>">
  <link rel="canonical" href="<%= (typeof canonical !== 'undefined' && canonical) ? canonical : 'https://www.uniremington.edu.co/' %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Corporación Universitaria Remington">
  <meta property="og:title" content="Corporación Universitaria Remington — Universidad Colombiana">
  <meta property="og:description" content="<%= _desc %>">
  <meta property="og:url" content="<%= (typeof canonical !== 'undefined' && canonical) ? canonical : 'https://www.uniremington.edu.co/' %>">
  <meta name="twitter:card" content="summary">
  <!-- El home referencia www.uniremington.edu.co más que cualquier otra página (logo,
       favicons, y las 5 imágenes de "Oferta Académica") — preconnect adelanta el DNS/TLS
       de ese origen en vez de esperar a que el navegador lo descubra en medio del render. -->
  <link rel="preconnect" href="https://www.uniremington.edu.co">
  <link rel="icon" href="https://www.uniremington.edu.co/wp-content/uploads/2018/10/favicon-uniremington-32x32.png" sizes="32x32">
  <link rel="icon" href="https://www.uniremington.edu.co/wp-content/uploads/2018/10/favicon-uniremington.png" sizes="192x192">
  <link rel="apple-touch-icon" href="https://www.uniremington.edu.co/wp-content/uploads/2018/10/favicon-uniremington.png">
  <% if (typeof jsonld !== 'undefined' && jsonld){ %><script type="application/ld+json"><%- JSON.stringify(jsonld) %></script><% } %>
  <!-- Sin preload a propósito: la fuente de íconos (220KB) competía por ancho de banda
       con el LCP en móvil bajo conexiones lentas (medido con PageSpeed Insights real).
       El navbar usa .msi casi de inmediato, así que el navegador la sigue descubriendo
       muy pronto — solo entra a prioridad normal en vez de forzada desde el primer byte. -->
  <!-- PT Sans (400/700 latin): son los únicos dos cortes de la tipografía que el texto
       visible realmente usa; precargarlos evita esperar a que el CSS termine de parsear
       para descubrirlos, acortando la cadena de dependencia crítica. -->
  <link rel="preload" href="/fonts/ptsans-3.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/ptsans-7.woff2" as="font" type="font/woff2" crossorigin>
  <!-- fonts.css + menu.css (navbar/megamenú/drawer) fusionados en una sola solicitud -->
  <link rel="stylesheet" href="/css/home-critical.css?v=<%= ASSET_V %>">
  <script>
  // Aplica las preferencias de accesibilidad guardadas (partials/accessibility.ejs) ANTES
  // del primer pintado, para evitar el parpadeo de tamaño/contraste normal→guardado.
  (function(){try{var s=JSON.parse(localStorage.getItem('a11yPrefs')||'{}'),c=[];
  if(s.fs>1)c.push('a11y-fs'+s.fs);
  ['contrast','gray','underline','readable','nomotion'].forEach(function(k){if(s[k])c.push('a11y-'+k)});
  if(c.length)document.documentElement.classList.add.apply(document.documentElement.classList,c);
  }catch(e){}})();
  </script>
  <style>
    .skip-link{position:fixed;top:-60px;left:12px;z-index:2000;background:#00457c;color:#fff;
      padding:10px 18px;border-radius:0 0 10px 10px;font-weight:700;text-decoration:none;
      box-shadow:0 6px 18px rgba(0,0,0,.25);transition:top .18s ease}
    .skip-link:focus{top:0;outline:3px solid #fff;outline-offset:-3px}
    /* SVG en línea en vez de la fuente de íconos (220KB, competía por ancho de banda con
       el LCP en móvil): mismos trazos exactos, extraídos del propio ms-sharp.woff2 con
       fontTools. Mismo comportamiento de tamaño/alineación que .msi para no romper layout. */
    .ico{width:1.2em;height:1.2em;display:inline-block;vertical-align:-.18em;fill:currentColor;flex:none}
    .ico path{fill:currentColor}
    /* Campo trampa anti-spam: invisible para personas, los bots que rellenan todos los
       campos caen en él y la solicitud se descarta en el servidor. */
    .hp-field{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
    /* ═══ Accesibilidad: clases que activa el widget flotante (partials/accessibility.ejs).
       Idéntico al bloque de site.css — home.ejs no carga ese archivo. ═══ */
    html.a11y-fs2{font-size:112.5%}
    html.a11y-fs3{font-size:125%}
    html.a11y-fs4{font-size:137.5%}
    /* Alto contraste SIN filter (un filter en <html> repinta toda la página en cada
       fotograma y frena el sitio): se elevan las variables de color de la home. */
    html.a11y-contrast{
      --blue:#002a4d;--blue-soft:#002a4d;--dark:#000;--muted:#000;
      --accent:#b00000;--accent-dark:#7a0000
    }
    html.a11y-contrast .post,html.a11y-contrast .ev,html.a11y-contrast .card{border:2px solid #000}
    html.a11y-gray{filter:grayscale(1)}
    html.a11y-underline a{text-decoration:underline!important;text-underline-offset:2px}
    html.a11y-readable body{letter-spacing:.02em;line-height:1.75}
    html.a11y-readable p,html.a11y-readable li,html.a11y-readable td,html.a11y-readable dd{word-spacing:.06em}
    html.a11y-nomotion *,html.a11y-nomotion *::before,html.a11y-nomotion *::after{
      animation-duration:.001ms!important;animation-iteration-count:1!important;
      transition-duration:.001ms!important;scroll-behavior:auto!important}
    :root {
      --blue: #00457c;
      --blue-soft: #0f6f9e;
      --light: #eef6fb;
      --accent: #e30613;
      --accent-dark: #b0050f;
      --dark: #0b2b3a;
      --muted: #5b6b78;
      /* Antes 1100px: el hero (.bento) usaba 1260px y todo el resto del contenido usaba
         este valor, así que la página se veía "encogerse" 160px justo al salir del hero.
         Se unifica al ancho del hero en vez de al revés para dar más aire a las tarjetas. */
      --container: 1260px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    body {
      font-family: 'PT Sans', sans-serif;
      color: var(--dark);
      background: #fff;
    }

    a {
      color: inherit;
      text-decoration: none
    }

    /* Layout */
    .wrap {
      max-width: var(--container);
      margin: 0 auto;
      padding: 28px
    }

    header {
      position: relative;
      z-index: 50
    }

    .btn {
      background-color: white;
      color: #e30613;
      padding: 8px 12px;
      border-radius: 8px;
      font-weight: 600
    }


    /* ═══════════════════════ HERO: BENTO GRID ═══════════════════════ */
    .hero {
      position: relative;
      overflow: hidden;
      background: #061c30;
      padding: 44px 0 40px;
      color: #fff;
    }

    /* Fondo "aurora": manchas de gradiente difuminadas y a la deriva (sin foto) */
    .hero-aurora {
      position: absolute;
      inset: -15%;
      z-index: 0;
      filter: blur(70px);
      pointer-events: none;
    }
    .hero-aurora span {
      position: absolute;
      border-radius: 50%;
      opacity: .55;
    }
    .hero-aurora span:nth-child(1) {
      width: 44vw; height: 44vw; top: -12%; left: -10%;
      background: radial-gradient(circle, #0077b6, transparent 70%);
      animation: auroraDrift1 24s ease-in-out infinite;
    }
    .hero-aurora span:nth-child(2) {
      width: 36vw; height: 36vw; bottom: -16%; right: -8%;
      background: radial-gradient(circle, #e30613, transparent 70%);
      opacity: .4;
      animation: auroraDrift2 28s ease-in-out infinite;
    }
    .hero-aurora span:nth-child(3) {
      width: 28vw; height: 28vw; top: 26%; left: 42%;
      background: radial-gradient(circle, #ffb703, transparent 70%);
      opacity: .28;
      animation: auroraDrift3 20s ease-in-out infinite;
    }
    @keyframes auroraDrift1 { 0%,100%{ transform: translate(0,0) scale(1);} 50%{ transform: translate(6%,8%) scale(1.15);} }
    @keyframes auroraDrift2 { 0%,100%{ transform: translate(0,0) scale(1);} 50%{ transform: translate(-8%,-6%) scale(1.1);} }
    @keyframes auroraDrift3 { 0%,100%{ transform: translate(0,0) scale(1);} 50%{ transform: translate(-10%,10%) scale(.9);} }

    /* Rejilla bento */
    .bento {
      position: relative;
      z-index: 1;
      max-width: 1260px;
      margin: 0 auto;
      padding: 0 28px;
      display: grid;
      grid-template-columns: 1.3fr 1fr 1fr;
      grid-template-rows: auto auto auto;
      gap: 16px;
      grid-template-areas:
        "headline media   media"
        "headline media   media"
        "link-a   link-b  link-c";
    }

    /* Celda base: vidrio esmerilado + spotlight que sigue al cursor */
    .bento-cell {
      position: relative;
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.055);
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      overflow: hidden;
      isolation: isolate;
    }
    .bento-cell::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, .16), transparent 60%);
      opacity: 0;
      transition: opacity .3s ease;
      pointer-events: none;
      z-index: 1;
    }
    .bento-cell:hover::before { opacity: 1; }

    /* Celda: titular */
    .bento-headline {
      grid-area: headline;
      padding: 36px 34px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 15px;
    }
    .hero-badge {
      display: inline-block;
      width: fit-content;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #fff;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.3px;
    }
    .hero h1 {
      font-size: 38px;
      line-height: 1.15;
      font-weight: 800;
    }
    /* Gradiente estático (sin animar background-position): PageSpeed marcaba el barrido
       como animación no compositada — fuerza repintado en vez de correr en la GPU. */
    .hero h1 .accent {
      display: block;
      background: linear-gradient(90deg, #ff8a80 0%, #ff6b6b 35%, #ffc069 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .hero p {
      font-size: 16px;
      line-height: 1.55;
      color: #c9d6e2;
      max-width: 480px;
    }
    .hero .cta-hero {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 200px;
      height: 55px;
      padding: 0 24px;
      border: 0;
      border-radius: 50px;
      color: #fff;
      font-size: 16px;
      font-weight: 600;
      text-align: center;
      background-image: linear-gradient(to right, #ff3b47, var(--accent), #c40410, #8a0209);
      background-size: 300% 100%;
      box-shadow: 0 5px 15px rgba(227, 6, 19, .4);
      cursor: pointer;
      transition: all .4s ease-in-out;
    }
    .hero .cta-hero:hover {
      background-position: 100% 0;
      transition: all .4s ease-in-out;
    }

    /* Mini-cifras secundarias dentro del titular (no ocupan celda propia) */
    .bento-meta {
      display: flex;
      gap: 26px;
      margin-top: 4px;
      padding-top: 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }
    .bento-meta .stat-num { font-size: 1.15rem; font-weight: 800; color: #fff; line-height: 1; }
    .bento-meta .stat-label { font-size: .72rem; color: #a9bbcb; margin-top: 2px; }

    /* Celda: media — mini-carrusel de ofertas de Mercadeo */
    .bento-media {
      grid-area: media;
      display: flex;
      flex-direction: column;
      min-height: 150px;
      color: #fff;
      overflow: hidden;
    }
    /* Viewport: solo la imagen: aquí vive el crossfade y el tilt 3D */
    .bm-viewport {
      position: relative;
      flex: 1;
      min-height: 0;
      overflow: hidden;
      transform: perspective(800px);
      transition: transform .15s ease;
    }
    .bm-slide {
      position: absolute; inset: 0;
      opacity: 0;
      visibility: hidden;
      transition: opacity .5s ease, visibility 0s linear .5s;
    }
    .bm-slide.is-active {
      opacity: 1;
      visibility: visible;
      transition: opacity .5s ease;
    }
    .bm-linkfull { position: absolute; inset: 0; display: block; }
    .bento-media img {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center 35%;
      transition: transform .6s ease;
    }
    .bm-slide:hover img { transform: scale(1.06); }
    .bento-media-cap {
      position: absolute;
      left: 14px; bottom: 14px;
      z-index: 2;
      max-width: calc(100% - 28px);
      display: inline-block;
      padding: 6px 12px;
      border-radius: 8px;
      background: rgba(4, 20, 36, .55);
      backdrop-filter: blur(4px);
      font-weight: 700;
      font-size: .92rem;
      line-height: 1.25;
    }
    /* Barra de controles: fuera de la imagen, debajo del viewport */
    .bm-controls {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      background: rgba(4, 20, 36, .55);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .bm-dots {
      display: flex;
      align-items: center;
      gap: 2px;
      flex: 1;
      justify-content: center;
    }
    /* Objetivo táctil real de 24x24 (WCAG 2.5.8); el punto visible es un ::after más pequeño */
    .bm-dot {
      width: 24px; height: 24px;
      padding: 0;
      border: none;
      background: transparent;
      cursor: pointer;
      display: grid;
      place-items: center;
    }
    .bm-dot::after {
      content: "";
      width: 7px; height: 7px;
      border-radius: 5px;
      background: rgba(255, 255, 255, 0.35);
      transition: background .25s ease, width .25s ease;
    }
    .bm-dot:hover::after { background: rgba(255, 255, 255, 0.6); }
    .bm-dot.is-active::after { width: 18px; background: #fff; }
    .bm-arrow, .bm-play {
      flex: none;
      width: 30px; height: 30px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.22);
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: background .25s ease, transform .2s ease;
    }
    .bm-arrow .ico, .bm-play .ico { font-size: 1.05rem; }
    .bm-arrow:hover, .bm-play:hover { background: rgba(255, 255, 255, 0.2); }
    .bm-arrow:active, .bm-play:active { transform: scale(.92); }
    .bm-arrow:focus-visible, .bm-play:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

    /* Celdas: accesos rápidos */
    .bento-link {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 18px 20px;
      color: #fff;
      transition: transform .25s ease, background .25s ease;
    }
    .bento-link:hover { transform: translateY(-3px); background: rgba(255, 255, 255, 0.08); }
    .bl-ic {
      flex: none;
      width: 42px; height: 42px;
      border-radius: 13px;
      background: rgba(255, 255, 255, 0.14);
      display: grid; place-items: center;
    }
    .bl-ic .ico { font-size: 1.2rem; }
    .bl-tx { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .bl-title { font-weight: 700; font-size: .95rem; }
    .bl-kicker { font-size: .78rem; color: #a9bbcb; }
    .bl-go {
      margin-left: auto;
      flex: none;
      font-size: 1.1rem;
      opacity: .65;
      transition: transform .25s ease, opacity .25s ease;
    }
    .bento-link:hover .bl-go { transform: translateX(4px); opacity: 1; }
    .bento-link-a { grid-area: link-a; }
    .bento-link-b { grid-area: link-b; }
    .bento-link-c { grid-area: link-c; }

    @media (prefers-reduced-motion: reduce) {
      .hero-aurora span { animation: none; }
      .hero h1 .accent { animation: none; }
    }

    /* Sección Educación que transforma realidades */
    .impacto {
      padding: 60px 0;
    }

    .impacto-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: stretch;
    }

    .impacto-img {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 50px rgba(0, 68, 123, 0.18);
    }

    .impacto-img::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, rgba(0, 68, 123, 0.0) 40%, rgba(0, 68, 123, 0.35) 100%);
      pointer-events: none;
    }

    .impacto-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      min-height: 420px;
      transition: transform 0.6s ease;
    }

    .impacto-img:hover img {
      transform: scale(1.04);
    }

    .impacto-eyebrow {
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 12px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .impacto-eyebrow::before {
      content: "";
      width: 28px;
      height: 2px;
      background: var(--accent);
      display: inline-block;
    }

    .impacto-text h2 {
      font-size: 2.4rem;
      color: var(--blue);
      font-weight: 800;
      line-height: 1.15;
      margin-bottom: 18px;
    }

    .impacto-text > p {
      color: #4a5560;
      line-height: 1.65;
      margin-bottom: 32px;
      font-size: 1.02rem;
    }

    .impacto-cifras {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .impacto-cifras .cifra {
      position: relative;
      padding: 22px 20px 20px;
      background: linear-gradient(135deg, #ffffff 0%, #f5fafd 100%);
      border-radius: 14px;
      border: 1px solid #e6eef5;
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
      overflow: hidden;
    }

    .impacto-cifras .cifra::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: linear-gradient(180deg, var(--blue), var(--accent));
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .impacto-cifras .cifra:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(0, 68, 123, 0.12);
      border-color: transparent;
    }

    .impacto-cifras .cifra:hover::before {
      opacity: 1;
    }

    .impacto-cifras .cifra-num {
      font-size: 2.2rem;
      font-weight: 800;
      background: linear-gradient(135deg, var(--blue) 0%, var(--blue-soft) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1;
      letter-spacing: -0.5px;
    }

    .impacto-cifras .cifra-titulo {
      font-weight: 700;
      color: var(--dark);
      margin: 8px 0 4px;
      font-size: 0.95rem;
    }

    .impacto-cifras .cifra-desc {
      font-size: 0.82rem;
      color: var(--muted);
      line-height: 1.45;
    }

    .impacto-cifras .cifra-destacada {
      grid-column: 1 / -1;
      background: linear-gradient(135deg, var(--blue) 0%, var(--blue-soft) 100%);
      border-color: transparent;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 22px;
    }

    .impacto-cifras .cifra-destacada::before {
      background: linear-gradient(180deg, #fff, var(--accent));
      opacity: 1;
    }

    .impacto-cifras .cifra-destacada .cifra-num {
      background: none;
      -webkit-text-fill-color: #fff;
      color: #fff;
      font-size: 2.6rem;
      flex-shrink: 0;
    }

    .impacto-cifras .cifra-destacada .cifra-titulo {
      color: #fff;
    }

    .impacto-cifras .cifra-destacada .cifra-desc {
      color: rgba(255, 255, 255, 0.85);
    }

    /* ═══════════════════════ LEAD-CTA: solicita información ═══════════════════════
       Rediseño completo: nada de dos paneles de igual altura con color plano. Ahora es
       un fondo "aurora" oscuro y animado (el mismo lenguaje visual del hero: manchas de
       gradiente a la deriva) con una tarjeta de vidrio flotante para el formulario —
       el texto y la tarjeta se acomodan cada uno a su propio contenido en vez de
       estirarse para igualar al otro, así nunca queda espacio vacío de sobra. */
    .lead-final {
      width: 100vw;
      position: relative;
      left: 50%;
      transform: translateX(-50%);
      margin-top: 24px;
      margin-bottom: -28px;
      padding: 0;
      overflow: hidden;
      background: #061c30;
    }

    .lead-final-inner {
      position: relative;
      z-index: 1;
      max-width: var(--container);
      margin: 0 auto;
      padding: 60px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 56px;
      flex-wrap: wrap;
    }

    .lead-final-pitch {
      flex: 1 1 400px;
      color: #fff;
    }

    .lead-final-eyebrow {
      color: #ff8f7a;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 14px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .lead-final-eyebrow::before {
      content: "";
      width: 28px;
      height: 2px;
      background: #ff8f7a;
      display: inline-block;
    }

    .lead-final-pitch h2 {
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1.15;
      margin-bottom: 14px;
      max-width: 15ch;
    }

    .lead-final-pitch > p {
      color: #cfe0ec;
      line-height: 1.6;
      font-size: 1rem;
      max-width: 42ch;
      margin-bottom: 22px;
    }

    /* Confianza en píldoras horizontales (no lista vertical apilada): mismo mensaje,
       una fracción de la altura. */
    .lead-final-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .lead-final-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.18);
      padding: 8px 14px 8px 10px;
      border-radius: 30px;
      font-size: 0.84rem;
      font-weight: 600;
      color: #e7f0f6;
      backdrop-filter: blur(6px);
    }

    .lead-final-pill .ico {
      color: var(--accent);
      font-size: 1.05rem;
      flex: none;
    }

    /* Tarjeta de vidrio flotante: tamaño propio (no estira para igualar al texto),
       fondo blanco con desenfoque leve para leerse bien sobre el aurora del fondo. */
    .lead-final-card {
      flex: 0 1 420px;
      width: 100%;
      max-width: 420px;
      background: rgba(255, 255, 255, 0.98);
      border-radius: 22px;
      padding: 30px 28px;
      box-shadow: 0 30px 70px rgba(0, 8, 25, 0.5), 0 1px 0 rgba(255, 255, 255, 0.6) inset;
      color: var(--dark);
    }

    .lead-final-card h3 {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--blue);
      margin-bottom: 3px;
    }

    .lead-final-card .sub {
      color: var(--muted);
      font-size: 0.86rem;
      margin-bottom: 16px;
    }

    /* Grid de 2 columnas: nombre/correo/teléfono/programa en pares, y lo que
       necesita más espacio (sede, mensaje, botón, aviso legal) ocupa la fila entera. */
    .lead-final-card form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px 12px;
    }

    .lead-final-card form .wide {
      grid-column: 1 / -1;
    }

    .lead-final-card input,
    .lead-final-card select,
    .lead-final-card textarea {
      padding: 11px 13px;
      border: 1px solid #dbe3ec;
      border-radius: 9px;
      font: inherit;
      font-size: 0.9rem;
      background: #f5f8fa;
      color: var(--dark);
      width: 100%;
      resize: vertical;
    }

    .lead-final-card textarea {
      min-height: 44px;
    }

    .lead-final-card input:focus,
    .lead-final-card select:focus,
    .lead-final-card textarea:focus {
      outline: 2px solid var(--blue-soft);
      background: #fff;
    }

    .lead-final-submit {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      background: var(--accent);
      color: #fff;
      border: 0;
      padding: 15px 20px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 1rem;
      font-family: inherit;
      cursor: pointer;
      box-shadow: 0 10px 24px rgba(227, 7, 21, 0.3);
      transition: background 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
      margin-top: 4px;
    }

    .lead-final-submit:hover {
      background: var(--accent-dark);
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(227, 7, 21, 0.4);
    }

    .lead-final-submit::after {
      content: "";
      position: absolute;
      top: 0;
      left: -60%;
      width: 45%;
      height: 100%;
      background: linear-gradient(115deg, transparent, rgba(255, 255, 255, 0.5), transparent);
      transform: skewX(-20deg);
      transition: left 0.65s ease;
      pointer-events: none;
    }

    .lead-final-submit:hover::after {
      left: 130%;
    }

    .lead-final-submit.loading {
      opacity: 0.85;
      cursor: progress;
    }

    .lead-final-submit .spin {
      display: inline-block;
      width: 15px;
      height: 15px;
      border: 2px solid rgba(255, 255, 255, 0.45);
      border-top-color: #fff;
      border-radius: 50%;
      animation: leadSpin 0.7s linear infinite;
      vertical-align: -2px;
    }

    @keyframes leadSpin {
      to { transform: rotate(360deg); }
    }

    .pf-fine {
      font-size: 0.74rem;
      color: var(--muted);
      line-height: 1.4;
      margin-top: 2px;
      display: flex;
      align-items: flex-start;
      gap: 6px;
    }

    .pf-fine .ico {
      font-size: 0.95rem;
      flex-shrink: 0;
    }

    .lead-ok {
      display: flex;
      gap: 12px;
      align-items: center;
      background: #e9f7ef;
      border: 1px solid #b7e6cf;
      border-radius: 14px;
      padding: 22px;
      color: #14603f;
    }

    .lead-ok .ico {
      font-size: 2rem;
      color: #1e9e5f;
    }

    .lead-ok strong {
      font-size: 1.1rem;
      color: #0f4f34;
    }

    .lead-ok p {
      margin: 2px 0 0;
      font-size: 0.9rem;
      color: #2c6a4e;
    }

    .lead-err {
      margin: 10px 0 0;
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 700;
    }

    @media (max-width: 860px) {
      .lead-final-inner {
        padding: 44px 20px;
        gap: 32px;
      }
      .lead-final-pitch h2 {
        font-size: 1.8rem;
        max-width: none;
      }
      .lead-final-pitch > p {
        max-width: none;
      }
      .lead-final-card {
        max-width: none;
      }
    }

    @media (max-width: 420px) {
      .lead-final-card form {
        grid-template-columns: 1fr;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .lead-final-submit .spin { animation: none; }
    }

    .cta-row {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap
    }

    /* Secciones */
    section {
      padding: 36px 0
    }

    /* ═══ Oferta Académica: grid de programas primero, video como cierre ═══ */
    .oferta-section { padding: 64px 0 8px; }

    .oferta-head {
      max-width: 640px;
      margin: 0 auto 40px;
      text-align: center;
    }
    .oferta-eyebrow {
      color: var(--accent);
      font-size: .85rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 12px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .oferta-eyebrow::before,
    .oferta-eyebrow::after {
      content: "";
      width: 28px;
      height: 2px;
      background: var(--accent);
      display: inline-block;
    }
    .oferta-head h2 {
      font-size: clamp(1.8rem, 1.2rem + 2.4vw, 2.5rem);
      color: var(--blue);
      font-weight: 800;
      line-height: 1.15;
      margin: 0 0 14px;
    }
    .oferta-head p {
      color: var(--muted);
      line-height: 1.65;
      font-size: 1.02rem;
      margin: 0;
    }

    /* Grid de programas (las "imágenes"): tarjetas con la etiqueta superpuesta sobre la
       foto (degradado inferior) en vez de una barra de color aparte — más compacto y con
       más presencia visual, con una barrita de color propia por categoría. */
    .oferta-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 18px;
    }
    .oferta-card {
      position: relative;
      border-radius: 18px;
      overflow: hidden;
      aspect-ratio: 3 / 4;
      box-shadow: 0 10px 28px rgba(0, 69, 124, .14);
      transition: transform .45s cubic-bezier(.22,.61,.36,1), box-shadow .4s ease;
    }
    .oferta-card:hover,
    .oferta-card:focus-within { transform: translateY(-8px); box-shadow: 0 24px 48px rgba(0, 69, 124, .26); }
    .oferta-card a { display: block; position: relative; width: 100%; height: 100%; outline-offset: 4px; }
    .oferta-card img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .8s cubic-bezier(.22,.61,.36,1);
    }
    .oferta-card:hover img { transform: scale(1.09); }
    .oferta-card::before {
      content: "";
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(3,20,40,0) 42%, rgba(2,14,28,.86) 100%);
      z-index: 1;
      pointer-events: none;
    }
    .oferta-card::after {
      content: "";
      position: absolute; left: 18px; bottom: 18px;
      width: 30px; height: 4px; border-radius: 2px;
      background: var(--card-accent, var(--accent));
      z-index: 2;
    }
    .oferta-card-tag {
      position: absolute; left: 18px; right: 18px; bottom: 30px;
      color: #fff; font-weight: 800; font-size: 1rem; letter-spacing: .01em;
      z-index: 2;
      text-shadow: 0 2px 10px rgba(0,0,0,.35);
    }
    .oferta-card--tecnologias       { --card-accent: var(--blue-soft); }
    .oferta-card--pregrados         { --card-accent: var(--blue); }
    .oferta-card--especializaciones { --card-accent: #2c7da0; }
    .oferta-card--maestrias         { --card-accent: #013a63; }
    .oferta-card--extension         { --card-accent: var(--accent); }


    /* Cierre: banner con el video institucional + CTA (fondo oscuro con degradado + halo
       de acento, mismo lenguaje que la franja final de "Solicita información"). */
    .oferta-closer {
      position: relative;
      overflow: hidden;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
      margin-top: 52px;
      padding: 44px;
      border-radius: 26px;
      background: linear-gradient(155deg, var(--dark) 0%, #0d3854 60%, var(--blue) 100%);
      color: #fff;
      box-shadow: 0 26px 60px rgba(0, 20, 50, .24);
    }
    .oferta-closer::before {
      content: "";
      position: absolute; inset: 0;
      background: radial-gradient(32vw 32vw at 95% 100%, rgba(227,6,19,.20), transparent 65%);
      pointer-events: none;
    }
    .oferta-closer-text { position: relative; z-index: 1; }
    .oferta-closer-eyebrow {
      color: #ff8f7a;
      font-size: .85rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
      margin-bottom: 12px; display: inline-flex; align-items: center; gap: 10px;
    }
    .oferta-closer-eyebrow::before { content: ""; width: 28px; height: 2px; background: #ff8f7a; display: inline-block; }
    .oferta-closer-text h3 { font-size: clamp(1.4rem, 1rem + 1.6vw, 1.9rem); font-weight: 800; margin: 0 0 14px; line-height: 1.2; }
    .oferta-closer-text p { color: #cfe0ec; line-height: 1.6; margin: 0 0 26px; max-width: 46ch; }
    .oferta-closer-btn {
      display: inline-block; background: var(--accent); color: #fff;
      padding: 12px 26px; border-radius: 10px; font-weight: 700; text-decoration: none;
      transition: background .3s, transform .2s;
    }
    .oferta-closer-btn:hover { background: var(--accent-dark); transform: translateY(-2px); }

    .oferta-closer-video { position: relative; z-index: 1; }

.oferta-closer-video iframe,
.video-thumb {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  height: auto;
  border-radius: 12px;
  overflow: hidden;
  background: #000;
  border: none;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

.video-thumb {
  cursor: pointer;
}

.video-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform 0.4s ease, opacity 0.3s ease;
}

.video-thumb:hover img {
  transform: scale(1.04);
  opacity: 0.9;
}

.video-thumb::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.45) 100%);
  pointer-events: none;
}

/* BOTÓN PLAY LIMPIO Y ELEGANTE (64px - ROJO UNIREMINGTON) */
.video-thumb .play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: #E30715; /* Rojo de marca directo */
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 20px rgba(227, 7, 21, 0.4);
  z-index: 2;
  transition: transform 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
}

/* Triángulo blanco clásico y bien centrado */
.video-thumb .play-btn::before {
  content: "";
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 10px 0 10px 18px;
  border-color: transparent transparent transparent #ffffff;
  margin-left: 3px; /* Centrado visual del triángulo */
}

/* Hover sobrio */
.video-thumb:hover .play-btn {
  transform: translate(-50%, -50%) scale(1.08);
  background: #C40411; /* Rojo un poco más oscuro al pasar el cursor */
  box-shadow: 0 8px 24px rgba(227, 7, 21, 0.55);
}

    /* ═══════════════ FOOTER ═══════════════ */
    footer {
      background: linear-gradient(180deg, #0b2b3a 0%, #071c27 100%);
      color: #fff;
      position: relative;
      overflow: hidden;
    }

    footer::before {
      content: "";
      position: absolute;
      top: -140px;
      right: -100px;
      width: 380px;
      height: 380px;
      background: radial-gradient(circle, rgba(0, 119, 182, 0.18) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .footer-top {
      max-width: var(--container);
      margin: 0 auto;
      padding: 56px 28px 32px;
      position: relative;
      z-index: 1;
    }

    .foot-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
      gap: 36px;
    }

    .foot-brand img {
      height: 46px;
      margin-bottom: 14px;
    }

    .foot-brand p {
      color: rgba(255, 255, 255, 0.65);
      font-size: 0.9rem;
      line-height: 1.6;
      max-width: 320px;
      margin-bottom: 18px;
    }

    .foot-social {
      display: flex;
      gap: 10px;
    }

    .foot-social a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      transition: background 0.25s ease, transform 0.25s ease;
    }

    .foot-social a:hover {
      background: var(--accent);
      transform: translateY(-3px);
    }

    .foot-social svg {
      width: 18px;
      height: 18px;
    }

    .foot-col h3 {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 16px;
      letter-spacing: 0.02em;
    }

    .foot-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .foot-col a {
      color: rgba(255, 255, 255, 0.65);
      font-size: 0.88rem;
      transition: color 0.2s ease, padding-left 0.2s ease;
    }

    .foot-col a:hover {
