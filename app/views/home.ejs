    <!-- ═══════════════ PREGUNTAS FRECUENTES (GEO/FAQ) ═══════════════ -->
    <section class="section faq-home" id="preguntas-frecuentes">
      <style>
        .faq-home{padding:clamp(40px,6vw,72px) 20px;background:var(--light,#eef6fb)}
        .faq-home .faq-wrap{max-width:820px;margin:0 auto}
        .faq-home h2{color:var(--blue,#00457c);font-size:clamp(1.6rem,3.4vw,2.2rem);margin:0 0 6px;text-align:center}
        .faq-home .faq-intro{text-align:center;color:#54606e;margin:0 0 28px}
        .faq-item{background:#fff;border:1px solid #e3e9f0;border-radius:14px;margin-bottom:12px;overflow:hidden;transition:box-shadow .2s ease}
        .faq-item[open]{box-shadow:0 12px 30px -16px rgba(0,40,80,.25)}
        .faq-item summary{list-style:none;cursor:pointer;padding:18px 22px;font-weight:700;color:var(--blue,#00457c);
          display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:1.02rem}
        .faq-item summary::-webkit-details-marker{display:none}
        .faq-item summary::after{content:"+";font-size:1.5rem;font-weight:400;color:var(--accent,#e30613);flex:none;transition:transform .2s ease}
        .faq-item[open] summary::after{transform:rotate(45deg)}
        .faq-item .faq-a{padding:0 22px 20px;color:#3a4551;line-height:1.6}
        .faq-item .faq-a p{margin:0}
      </style>
      <div class="faq-wrap">
        <h2>Preguntas frecuentes</h2>
        <p class="faq-intro">Lo que más consultan aspirantes y estudiantes sobre Uniremington.</p>
        <div class="faq-list">
          <% (typeof faqs !== 'undefined' ? faqs : []).forEach(function(f){ %>
          <details class="faq-item">
            <summary><%= f[0] %></summary>
            <div class="faq-a"><p><%= f[1] %></p></div>
          </details>
          <% }) %>
        </div>
      </div>
    </section>

