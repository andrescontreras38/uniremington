{
  "name": "uniremington-web",
  "version": "0.1.0",
  "description": "Migración del sitio de la Corporación Universitaria Remington desde WordPress a Node/Express + EJS",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env server.js",
    "dev": "node --env-file-if-exists=../.env --watch server.js",
    "admin:create-user": "node --env-file-if-exists=../.env scripts/create-admin-user.mjs",
    "admin:migrate": "node --env-file-if-exists=../.env scripts/migrate-content-to-sqlite.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
